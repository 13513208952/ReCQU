<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_today_courses"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_today_subtitle"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_course_row_1"
        style="@style/WidgetCourseRow"
        android:text="@string/widget_preview_course_row_1" />

    <TextView
        android:id="@+id/widget_course_row_2"
        style="@style/WidgetCourseRow"
        android:text="@string/widget_preview_course_row_2" />

    <TextView
        android:id="@+id/widget_course_row_3"
        style="@style/WidgetCourseRow"
        android:text="@string/widget_preview_course_row_1" />

    <TextView
        android:id="@+id/widget_course_row_4"
        style="@style/WidgetCourseRow"
        android:text="@string/widget_preview_course_row_2" />
</LinearLayout>
